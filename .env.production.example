# Public-safe example only. Put real values in the server's private .env file.
APP_HOST=private-server-ip
EXPRESS_DATA_ROOT=/srv/express-intelligence
EXPRESS_BACKUP_ROOT=/srv/express-intelligence-backups
POSTGRES_DB=express_intelligence
POSTGRES_USER=express
POSTGRES_PASSWORD=replace-with-a-long-random-secret
REDIS_PASSWORD=replace-with-a-different-long-random-secret
MAX_FILE_BYTES=5000000000
STORAGE_RESERVE_BYTES=20000000000
MAX_ACTIVE_UPLOADS=1
MAX_CHUNK_BYTES=16777216
RATE_LIMIT_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_MINUTE=10
WORKER_REPLICAS=1
BACKUP_RETENTION_DAYS=3
DB_POOL_SIZE=8
REMOTE_MAX_OBJECTS=5000
REMOTE_MAX_TOTAL_BYTES=20000000000
REMOTE_MAX_SCANNED_KEYS=1000000
# Never commit the actual bucket names or prefixes below.
FE_CLOUDFRONT_BUCKET=
FE_CLOUDFRONT_PREFIX=
FE_AKAMAI_BUCKET=
FE_AKAMAI_PREFIX=
